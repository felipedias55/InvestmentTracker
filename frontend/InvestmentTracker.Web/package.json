{
  "name": "investment-tracker.web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format:check": "prettier --config .prettierrc --check \"*.{json,mjs,cjs}\" .prettierrc ../../global.json \"../../.github/workflows/*.yml\"",
    "format": "prettier --config .prettierrc --write \"*.{json,mjs,cjs}\" .prettierrc ../../global.json \"../../.github/workflows/*.yml\"",
    "test:presentation": "playwright test --config=playwright.presentation.config.ts",
    "start:lan": "ng serve --host=0.0.0.0",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/Test-EndToEnd.ps1"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
